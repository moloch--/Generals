thumbs.db
/CMakeUserPresets.json
/.generalsx-local.cmake
/.cache
.clang-format
/Dependencies/MaxSDK/maxsdk
/tmp/

# GeneralsX @build Codex 05/08/2026 Keep generated Wails and frontend artifacts out of source control.
/tools/generalsx-build-desktop/build/bin/
/tools/generalsx-build-desktop/frontend/node_modules/
/tools/generalsx-build-desktop/frontend/coverage/
/tools/generalsx-build-desktop/frontend/dist/*
!/tools/generalsx-build-desktop/frontend/dist/gitkeep
/tools/generalsx-build-desktop/frontend/package.json.md5

# GeneralsX @build OpenAI 01/08/2026 Keep the standalone Online server as its own adjacent Git repository.
/generals-server/

## AI assistant config (user-specific)
/.claude/
/CLAUDE.md

## IntelliJ, CLion, etc.
/.idea

# IntelliJ-style CMake bits
cmake-build-*/

## Ninja
.ninja_deps
.ninja_log
build.ninja

## Python
__pycache__/
*.pyc

## Build Logs (generated during development)
/logs/
GeneralsMD/logs/
Generals/logs/

# vcpkg artifacts (generated dependencies)
/vcpkg_installed/

# External reference repositories (large, don't commit)
# references/

# Release bundles
GeneralsX-macos-*.zip
GeneralsXZH-macos-*.zip
GeneralsX-linux-*.tar.gz
GeneralsXZH-linux-*.tar.gz

# flatpak build files (exclude staging/build dirs but track scripts and manifests)
.flatpak-builder/
flatpak/staging/
flatpak/*.flatpak

#tmp and log files on root folder
logs_*.zip
*.log
# iOS shell-app build products (XcodeGen regenerates the project from ios/project.yml)
ios/build/
ios/GeneralsXZH.xcodeproj/
